# ==========================================
# KALEVALENS - GOOGLE GEMINI CONFIGURATION
# ==========================================
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY_HERE
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_MODEL_CLASSIFICATION=gemini-2.5-flash
GEMINI_MODEL_SOURCE_VERIFICATION=gemini-2.5-flash
GEMINI_MODEL_STORY_SELECTION=gemini-2.5-flash
GEMINI_MODEL_NEWS_GENERATION=gemini-2.5-flash
GEMINI_MODEL_CONTENT_VERIFICATION=gemini-2.5-flash
GEMINI_MODEL_TRANSLATION=gemini-2.5-flash
GEMINI_MODEL_CONTEXTUALIZATION=gemini-2.5-flash
GEMINI_MODEL_PERSONALIZATION=gemini-2.5-flash
GEMINI_MODEL_COMMUNITY_INTELLIGENCE=gemini-2.5-flash
AGENT_MAX_RETRIES=3
AGENT_MAX_REVISION_CYCLES=2
AGENT_TIMEOUT_MS=60000

# Comma-separated RSS URLs. Leave empty until real sources are configured.
NEWS_RSS_FEEDS=

# PostgreSQL / Prisma. DIRECT_URL can equal DATABASE_URL for local PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Signs the prototype server session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Moderator demo login; replace outside local development.
MODERATOR_PASSCODE=REPLACE_WITH_A_PRIVATE_PASSCODE


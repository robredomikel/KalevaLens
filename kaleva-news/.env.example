# Required -------------------------------------------------------------------
# Create a Neon Postgres project and paste its connection string here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key

# Endpoint security ----------------------------------------------------------
# Replace both values with long, random strings for any shared deployment.
CRON_SECRET=replace-with-a-long-random-secret
MEDIA_JOB_SECRET=replace-with-a-different-long-random-secret

# News ingestion -------------------------------------------------------------
# Optional comma-separated list. Leave blank to use the built-in source list.
NEWS_RSS_FEEDS=

# Gemini models --------------------------------------------------------------
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_MODEL_NARRATION=gemini-2.5-flash
GEMINI_MODEL_AUDIO=gemini-3.1-flash-tts-preview
GEMINI_MODEL_MEDIA_QA=gemini-2.5-flash

# Optional per-agent overrides. Blank values use GEMINI_MODEL_DEFAULT.
GEMINI_MODEL_CLASSIFICATION=
GEMINI_MODEL_SOURCE_VERIFICATION=
GEMINI_MODEL_STORY_SELECTION=
GEMINI_MODEL_NEWS_GENERATION=
GEMINI_MODEL_CONTENT_VERIFICATION=
GEMINI_MODEL_TRANSLATION=
GEMINI_MODEL_CONTEXTUALIZATION=
GEMINI_MODEL_PERSONALIZATION=
GEMINI_MODEL_COMMUNITY_INTELLIGENCE=

# AI workflow limits ---------------------------------------------------------
AGENT_MAX_RETRIES=3
AGENT_MAX_REVISION_CYCLES=2
AGENT_TIMEOUT_MS=60000

# Audio and media jobs -------------------------------------------------------
MEDIA_AUDIO_ENABLED=true
MEDIA_AUTO_PROCESS_ON_START=true
MEDIA_LANGUAGES=en
MEDIA_TTS_VOICE=Kore
MEDIA_DEFAULT_AUDIO_DURATION_SECONDS=30
MEDIA_MAX_AUDIO_DURATION_SECONDS=30
MEDIA_MAX_RETRIES=3
MEDIA_MAX_CONCURRENT_JOBS=2
MEDIA_JOB_TIMEOUT_MS=300000
MEDIA_WORKER_INTERVAL_MS=15000

# Demo mode limits background generation to a small number of articles.
MEDIA_DEMO_MODE=true
MEDIA_DEMO_ARTICLE_LIMIT=3

# These defaults resolve inside kaleva-news/ when npm commands are run there.
MEDIA_STORAGE_ROOT=public/generated-media
MEDIA_PUBLIC_BASE_URL=/generated-media

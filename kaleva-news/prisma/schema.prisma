datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  passwordHash       String
  role               UserRole            @default(READER)
  community          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  submissions        StorySubmission[]
  profile            UserProfile?
  comments           Comment[]
  editorialDecisions EditorialDecision[]
  correctionRequests CorrectionRequest[]
  assignedTasks      EditorialTask[]     @relation("AssignedEditor")
  agentExecutions    AgentExecution[]
}

model UserProfile {
  id                    String     @id @default(uuid())
  userId                String     @unique
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences           Json
  communityId           String?
  selectedCommunity     Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  onboardingCompleted   Boolean    @default(false)
  onboardingCompletedAt DateTime?
  currentQuestion       Int        @default(0)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([communityId])
}

model Community {
  id          String             @id @default(uuid())
  slug        String             @unique
  name        String             @unique
  description String?
  imageUrl    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  profiles    UserProfile[]
  articles    CanonicalArticle[]
  comments    Comment[]
  candidates  NewsCandidate[]
}

model StorySubmission {
  id        String         @id @default(uuid())
  title     String
  summary   String         @db.Text
  content   String?        @db.Text
  community String
  category  String?        @default("Citizen Scoop")
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  stage     KanbanStage    @default(INCOMING)
  priority  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  candidate NewsCandidate?
}

model NewsSource {
  id            String          @id @default(uuid())
  name          String
  url           String          @unique
  type          SourceType
  enabled       Boolean         @default(true)
  attribution   String?
  lastFetchedAt DateTime?
  lastError     String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  candidates    NewsCandidate[]
}

model NewsCandidate {
  id             String            @id @default(uuid())
  sourceId       String?
  source         NewsSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  submissionId   String?           @unique
  submission     StorySubmission?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  communityId    String?
  community      Community?        @relation(fields: [communityId], references: [id], onDelete: SetNull)
  externalId     String?
  originalUrl    String?
  title          String
  description    String?           @db.Text
  content        String?           @db.Text
  language       String?
  publishedAt    DateTime?
  contentHash    String            @unique
  status         CandidateStatus   @default(INGESTED)
  classification Json?
  ingestionError String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  evidence       EvidenceRecord[]
  article        CanonicalArticle?
  workflow       WorkflowRun?
  editorialTasks EditorialTask[]

  @@index([sourceId, publishedAt])
  @@index([status, createdAt])
  @@index([communityId])
}

model EvidenceRecord {
  id          String        @id @default(uuid())
  candidateId String
  candidate   NewsCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  url         String
  title       String?
  publisher   String?
  retrievedAt DateTime      @default(now())
  publishedAt DateTime?
  excerpt     String?       @db.Text
  claims      Json?
  checksum    String?
  createdAt   DateTime      @default(now())

  @@unique([candidateId, url])
  @@index([candidateId])
}

model CanonicalArticle {
  id             String                  @id @default(uuid())
  candidateId    String                  @unique
  candidate      NewsCandidate           @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  communityId    String?
  community      Community?              @relation(fields: [communityId], references: [id], onDelete: SetNull)
  status         ArticleStatus           @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  versions       ArticleVersion[]
  localizations  LocalizedArticle[]
  explanations   ContextualExplanation[]
  comments       Comment[]
  corrections    CorrectionRequest[]
  editorialTasks EditorialTask[]

  @@index([status, publishedAt])
  @@index([communityId, status])
}

model ArticleVersion {
  id               String                  @id @default(uuid())
  articleId        String
  article          CanonicalArticle        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version          Int
  headline         String
  lead             String                  @db.Text
  body             String                  @db.Text
  summary          Json
  categories       String[]
  sourceReferences Json
  claimEvidence    Json
  verification     Json?
  createdAt        DateTime                @default(now())
  decisions        EditorialDecision[]
  editorialTasks   EditorialTask[]
  localizations    LocalizedArticle[]
  explanations     ContextualExplanation[]

  @@unique([articleId, version])
  @@index([articleId, createdAt])
}

model EditorialTask {
  id               String              @id @default(uuid())
  workflowId       String
  checkpoint       HumanCheckpoint
  status           ReviewStatus        @default(PENDING)
  candidateId      String?
  candidate        NewsCandidate?      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  articleId        String?
  article          CanonicalArticle?   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleVersionId String?
  articleVersion   ArticleVersion?     @relation(fields: [articleVersionId], references: [id], onDelete: Cascade)
  assignedEditorId String?
  assignedEditor   User?               @relation("AssignedEditor", fields: [assignedEditorId], references: [id], onDelete: SetNull)
  reason           String?             @db.Text
  metadata         Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  decisions        EditorialDecision[]

  @@index([status, checkpoint, createdAt])
  @@index([workflowId])
}

model EditorialDecision {
  id               String          @id @default(uuid())
  taskId           String
  task             EditorialTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  articleVersionId String?
  articleVersion   ArticleVersion? @relation(fields: [articleVersionId], references: [id], onDelete: Restrict)
  moderatorId      String
  moderator        User            @relation(fields: [moderatorId], references: [id], onDelete: Restrict)
  decision         EditorialAction
  notes            String?         @db.Text
  createdAt        DateTime        @default(now())

  @@index([taskId, createdAt])
  @@index([articleVersionId])
}

model WorkflowRun {
  id            String           @id
  candidateId   String           @unique
  candidate     NewsCandidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status        WorkflowStatus   @default(RUNNING)
  currentAgent  String?
  waitingFor    HumanCheckpoint?
  revisionCount Int              @default(0)
  lastError     String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  executions    AgentExecution[]
}

model AgentExecution {
  id              String          @id @default(uuid())
  workflowId      String?
  workflow        WorkflowRun?    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  agentIdentifier String
  model           String?
  status          ExecutionStatus @default(RUNNING)
  inputRefs       Json?
  outputRefs      Json?
  promptTokens    Int?
  outputTokens    Int?
  estimatedCost   Decimal?        @db.Decimal(12, 8)
  errorDetails    String?         @db.Text
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  actorId         String?
  actor           User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workflowId, startedAt])
  @@index([agentIdentifier, status])
}

model LocalizedArticle {
  id               String             @id @default(uuid())
  articleId        String
  article          CanonicalArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleVersionId String
  articleVersion   ArticleVersion     @relation(fields: [articleVersionId], references: [id], onDelete: Cascade)
  language         String
  mode             LocalizationMode   @default(STANDARD)
  headline         String
  lead             String             @db.Text
  body             String             @db.Text
  summary          Json
  consistencyCheck Json?
  status           LocalizationStatus @default(PENDING_REVIEW)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([articleVersionId, language, mode])
  @@index([articleId, language, status])
}

model ContextualExplanation {
  id               String           @id @default(uuid())
  articleId        String
  article          CanonicalArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleVersionId String
  articleVersion   ArticleVersion   @relation(fields: [articleVersionId], references: [id], onDelete: Cascade)
  level            ContextLevel
  familiarityBand  String
  language         String
  content          Json
  referenceSources Json
  createdAt        DateTime         @default(now())

  @@unique([articleVersionId, level, familiarityBand, language])
}

model Comment {
  id             String           @id @default(uuid())
  articleId      String
  article        CanonicalArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId       String
  author         User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  communityId    String?
  community      Community?       @relation(fields: [communityId], references: [id], onDelete: SetNull)
  parentId       String?
  parent         Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]        @relation("CommentReplies")
  body           String           @db.Text
  classification Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([articleId, createdAt])
  @@index([parentId])
  @@index([communityId, createdAt])
}

model CorrectionRequest {
  id              String           @id @default(uuid())
  articleId       String
  article         CanonicalArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  requesterId     String
  requester       User             @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  disputedClaim   String           @db.Text
  explanation     String           @db.Text
  status          CorrectionStatus @default(PENDING)
  editorialTaskId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([articleId, status])
  @@index([requesterId, createdAt])
}

enum UserRole {
  READER
  CITIZEN_REPORTER
  MODERATOR
  ADMIN
}

enum KanbanStage {
  INCOMING
  REVIEW
  PUBLISHED
  REJECTED
}

enum SourceType {
  RSS
  OFFICIAL
  EXTERNAL
  CITIZEN
}

enum CandidateStatus {
  INGESTED
  CLASSIFIED
  NEEDS_REVIEW
  VERIFIED
  SELECTED
  DRAFTED
  REJECTED
  FAILED
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
}

enum HumanCheckpoint {
  SOURCE_REVIEW
  FINAL_APPROVAL
  CORRECTION_REVIEW
}

enum ReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  ESCALATED
}

enum EditorialAction {
  APPROVE
  REQUEST_CHANGES
  REJECT
  ESCALATE
  REQUEST_EVIDENCE
}

enum WorkflowStatus {
  RUNNING
  WAITING_HUMAN
  COMPLETED
  REJECTED
  FAILED
}

enum ExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  RETRYING
}

enum LocalizationMode {
  STANDARD
  SIMPLIFIED
  TRANSLATION_ASSISTED
}

enum LocalizationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ContextLevel {
  BRIEF
  BALANCED
  DETAILED
  ADAPTIVE
}

enum CorrectionStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}
